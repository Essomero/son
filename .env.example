# Son — environment configuration
# Copy this file to .env and fill in your key. Create a free key at
# https://console.groq.com (no credit card required for the free tier).

# Required — Groq API key (STT + LLM)
GROQ_API_KEY=

# Optional — add any of these to unlock more providers in the ⚙ settings panel:
# CEREBRAS_API_KEY=    # Cerebras brains (gpt-oss-120b, zai-glm-4.7) — cloud.cerebras.ai
# DEEPSEEK_API_KEY=    # DeepSeek brains (deepseek-v4-flash / deepseek-v4-pro)
# GEMINI_API_KEY=      # Gemini brains + Gemini voices
# OPENROUTER_API_KEY=  # curated OpenRouter brains (Claude, GPT, Grok, ...)
#
# Google speech-to-text needs GCP credentials, not the Gemini key:
# (Cloud Speech-to-Text V2 has no API-key auth in pipecat)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#   or: gcloud auth application-default login

# Optional overrides (defaults the settings panel lands on)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=medium   # gpt-oss only: low (fastest) / medium / high (smartest)
# GROQ_STT_MODEL=whisper-large-v3-turbo
# KOKORO_VOICE=af_heart
